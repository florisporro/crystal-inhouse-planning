# Drizzle
DATABASE_URL=file:local.db

ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Postmark — leave POSTMARK_TOKEN empty to log emails to the console instead
POSTMARK_TOKEN=""
POSTMARK_FROM="noreply@crystal.rx0.io"

# Admin logins, comma-separated (e.g. "manager@vve.nl,you@example.com"); empty = no admins
ADMIN_EMAILS=""

# Apartments paired with any of these emails are marked "not sold" (comma-separated)
UNSOLD_EMAIL=""

# Bird outbound calls (gate opener) — leave BIRD_SIP_DOMAIN empty to simulate the
# call instead of placing it. The phone numbers are secrets: never commit them.
# Bird's Voice product originates calls over SIP, not HTTP.
BIRD_KEY=""            # also the SIP digest password (username is always "bird")
BIRD_SIP_DOMAIN=""     # trunk domain, copied whole from the trunk page
GATE_TO_NUMBER=""      # the gate GSM unit, E.164
GATE_FROM_NUMBER=""    # verified caller ID, E.164
GATE_RING_MS="4000"    # how long to ring before hanging up — tune this at the gate
# We only dial out, so these listen ports are arbitrary; override to run two
# instances on one host.
SIP_PORT="5160"
SIP_TLS_PORT="5161"

# Shown to the resident as a fallback contact if the gate call fails
HUISMEESTER_PHONE=""
